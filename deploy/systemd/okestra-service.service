[Unit]
Description=Okestra remote Docker service
Documentation=https://github.com/jonace-mpelule/okestra
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=okestra
Group=okestra
SupplementaryGroups=docker
EnvironmentFile=/etc/okestra/okestra.env
ExecStart=/usr/local/bin/okestra-service
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/okestra
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
